PORT=3000
NODE_ENV=development
SESSION_COOKIE_SECURE=false
# Set to true only when running behind a trusted reverse proxy (needed for correct client IPs).
TRUST_PROXY=false

# AI provider (server-side only). Without AI_API_KEY, chat reports that setup is required.
# Default: Google Gemini. Get a key at https://aistudio.google.com/apikey
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.5-flash
# Tried in order if the main model is busy, rate-limited, unavailable, or too slow.
AI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
# Total wait for a reply, and the longest any one model attempt may take.
AI_TIMEOUT_MS=60000
AI_ATTEMPT_TIMEOUT_MS=25000
# Gemini reads images and PDFs natively (default true). For AI_PROVIDER=openai-compatible
# these default to false; enable only if that model genuinely accepts these inputs.
AI_IMAGE_INPUT=true
AI_PDF_INPUT=true
# Optional override of the provider API root (defaults per provider).
# AI_BASE_URL=

# Attachments (bytes)
ATTACHMENT_MAX_BYTES=8388608
ATTACHMENT_QUOTA_BYTES=209715200

# Sign-in/registration attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20
